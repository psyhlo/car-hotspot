[Desktop Entry]
Type=Application
X-Nemo-Application-Type=silica-qt5
Icon=harbour-carhotspot
Exec=harbour-carhotspot
Name=Car Hotspot
Comment=Toggles the Wi-Fi hotspot when the car Bluetooth device connects
Categories=Application;Network;
Name[bg]=Хотспот за кола
Name[de]=Fahrzeug-Hotspot
Name[es]=Punto de acceso para coche
Name[fr]=Point d'accès voiture
Name[it]=Hotspot auto
Name[ru]=Точка доступа авто
Name[sv]=Mobil hotspot för bil
Name[fi]=Auton yhteyspiste

# Jolla Harbour rejects a custom ExecDBus entry, so none is declared here. A notification
# tap still opens the application: the notification carries the "desktop-entry" hint,
# lipstick activates the registered bus name harbour-carhotspot.harbour-carhotspot and the
# exported openApp()/activate() slots raise the window. When the UI process is not running,
# lipstick launches it through this desktop entry (applauncherd + the X-Sailjail profile).
[X-Sailjail]
OrganizationName=harbour-carhotspot
ApplicationName=harbour-carhotspot
Permissions=Bluetooth;Internet
